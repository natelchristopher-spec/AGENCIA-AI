# Generación, crítica y propuesta de temas
OPENAI_API_KEY=

# Modelos por rol. El crítico corre sobre uno distinto del generador a
# propósito: un modelo juzgando su propia salida tiende a darse la razón.
OPENAI_MODEL_GENERAR=gpt-4o
OPENAI_MODEL_CRITICAR=gpt-4o-mini
OPENAI_MODEL_PROPONER=gpt-4o

# Cierra /api/contenido/*. Sin esto las rutas quedan abiertas y la UI avisa.
APP_PASSWORD=

# Persistencia de la cola. Sin esto el sistema corre en memoria y no persiste.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protege /api/cron/*. Sin este valor el endpoint queda cerrado a propósito.
CRON_SECRET=
